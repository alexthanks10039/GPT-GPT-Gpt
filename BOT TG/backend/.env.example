PORT=3000
TG_KEY=put_bot_token_from_botfather_here
OWNER_ID=put_your_telegram_chat_id_here

# Local development: backend pulls Telegram commands itself.
BOT_UPDATE_MODE=polling
DELETE_WEBHOOK_ON_POLLING=true
POLLING_TIMEOUT_SECONDS=25
POLLING_RETRY_MS=3000

# Production or tunnel webhook mode.
PUBLIC_BASE_URL=
WEBHOOK_PATH=/api/telegram/webhook
SITE_ORIGIN=http://127.0.0.1:4174
